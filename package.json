{
  "name": "hellowords",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-vocabulary.mjs && node scripts/semantic-validate.mjs && node scripts/validate-lexical-world.mjs && tsx scripts/validate-scenes.ts",
    "test:unit": "tsx --test tests/domain/*.test.ts && node --test tests/semantic/*.test.mjs tests/lexical-world/*.test.mjs",
    "test:ssr": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test tests/e2e --project=chromium --project=mobile-chromium",
    "test:perf": "playwright test --project=performance",
    "analyze:build": "node scripts/analyze-build.mjs",
    "test": "npm run typecheck && npm run validate:data && npm run test:unit && npm run build && npm run test:ssr",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify": "npm run lint && npm test && npm run analyze:build",
    "verify:full": "npm run verify && npm run test:e2e && PERF_RUN=1 npm run test:perf"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@playwright/test": "1.62.1",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "tsx": "4.23.11",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
